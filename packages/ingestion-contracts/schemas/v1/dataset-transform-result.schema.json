{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flahaintel.local/ingestion/v1/dataset-transform-result.schema.json",
  "title": "DatasetTransformResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "inputArtifactIds", "datasetArtifacts", "schemaArtifact", "statisticsArtifact", "manifestArtifact", "rowCount", "columnCount", "partitionCount", "schemaFingerprint", "nullCount", "rejectedRowCount", "sourceSheets", "warnings", "metrics", "derivation"],
  "properties": {
    "operation": { "const": "DATASET_TRANSFORM" },
    "inputArtifactIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/uuid" } },
    "datasetArtifacts": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "artifact-reference.schema.json" } },
    "schemaArtifact": { "$ref": "artifact-reference.schema.json" },
    "statisticsArtifact": { "$ref": "artifact-reference.schema.json" },
    "manifestArtifact": { "$ref": "artifact-reference.schema.json" },
    "rowCount": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "columnCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "partitionCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "schemaFingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
    "nullCount": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "rejectedRowCount": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "sourceSheets": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
    "warnings": { "type": "array", "maxItems": 1000, "items": { "$ref": "ingestion-warning.schema.json" } },
    "metrics": { "$ref": "common.schema.json#/$defs/resourceMetrics" },
    "derivation": { "$ref": "common.schema.json#/$defs/derivation" }
  }
}
