{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flahaintel.local/ingestion/v1/policy-snapshot.schema.json",
  "title": "PolicySnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyId", "policyVersion", "issuedAt", "operation", "allowedInputArtifactIds", "stagingPrefix", "allowedOutputMediaTypes", "maxWallTimeMs", "cancellationGraceMs", "maxInputBytes", "maxOutputBytes", "maxArtifactBytes", "maxOutputArtifacts", "maxWarnings", "maxMemoryBytes", "maxDiskBytes", "networkMode", "allowExternalResources", "allowEmbeddedFiles", "maxEmbeddedFiles", "maxArchiveEntries", "maxArchiveDepth", "maxExpandedBytes", "maxCompressionRatio", "maxPages", "maxRows", "maxColumns"],
  "properties": {
    "policyId": { "$ref": "common.schema.json#/$defs/uuid" },
    "policyVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "issuedAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "operation": { "enum": ["DOCUMENT_CONVERSION", "CONTENT_EXTRACTION", "DATASET_TRANSFORM"] },
    "allowedInputArtifactIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/uuid" } },
    "stagingPrefix": { "$ref": "common.schema.json#/$defs/relativeArtifactKey" },
    "allowedOutputMediaTypes": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/mediaType" } },
    "maxWallTimeMs": { "type": "integer", "minimum": 100, "maximum": 86400000 },
    "cancellationGraceMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "maxInputBytes": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "maxOutputBytes": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "maxArtifactBytes": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "maxOutputArtifacts": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "maxWarnings": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "maxMemoryBytes": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "maxDiskBytes": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "networkMode": { "enum": ["DENY_ALL", "GOVERNED_FETCH"] },
    "allowExternalResources": { "const": false },
    "allowEmbeddedFiles": { "type": "boolean" },
    "maxEmbeddedFiles": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "maxArchiveEntries": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "maxArchiveDepth": { "type": "integer", "minimum": 0, "maximum": 10 },
    "maxExpandedBytes": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "maxCompressionRatio": { "type": "number", "minimum": 1, "maximum": 1000 },
    "maxPages": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "maxRows": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "maxColumns": { "type": "integer", "minimum": 1, "maximum": 100000 }
  }
}
