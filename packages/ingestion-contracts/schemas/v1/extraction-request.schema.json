{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flahaintel.local/ingestion/v1/extraction-request.schema.json",
  "title": "ExtractionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "inputArtifact", "outputStagingPrefix", "profileId", "profileVersion", "inputKind", "requestedFields", "languageHints", "textDirectionHint", "extractLinks", "extractTables", "providerOptions"],
  "properties": {
    "operation": { "const": "CONTENT_EXTRACTION" },
    "inputArtifact": { "$ref": "artifact-reference.schema.json" },
    "outputStagingPrefix": { "$ref": "common.schema.json#/$defs/relativeArtifactKey" },
    "profileId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" },
    "profileVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "inputKind": { "enum": ["HTML", "NORMALIZED_DOCUMENT", "MARKDOWN"] },
    "requestedFields": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "enum": ["TITLE", "AUTHOR", "PUBLISHED_AT", "SUMMARY", "MAIN_CONTENT", "LINKS", "TABLES", "LANGUAGE", "DIRECTION"] } },
    "languageHints": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/languageTag" } },
    "textDirectionHint": { "enum": ["AUTO", "LTR", "RTL", "MIXED"] },
    "extractLinks": { "type": "boolean" },
    "extractTables": { "type": "boolean" },
    "providerOptions": { "type": "object", "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }, "maxProperties": 128 }
  }
}
