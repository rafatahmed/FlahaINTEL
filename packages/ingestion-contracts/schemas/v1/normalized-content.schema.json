{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flahaintel.local/ingestion/v1/normalized-content.schema.json",
  "title": "NormalizedContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "normalizedContentId",
    "schemaVersion",
    "sourceArtifactIds",
    "sourceExtractionJobId",
    "contentType",
    "normalizationProfile",
    "normalizationVersion",
    "normalizationProfileHash",
    "normalizationInputHash",
    "rawNormalizedTextHash",
    "structuralContentHash",
    "warnings",
    "qualityIndicators",
    "provenance"
  ],
  "properties": {
    "normalizedContentId": { "$ref": "common.schema.json#/$defs/uuid" },
    "schemaVersion": { "const": "3J.1.0" },
    "sourceArtifactIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "role", "sha256"],
        "properties": {
          "artifactId": { "$ref": "common.schema.json#/$defs/uuid" },
          "role": { "enum": ["EXTRACTED_TEXT", "STRUCTURE", "METADATA", "TABLE", "RESULT"] },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "sourceAcquisitionJobId": { "anyOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "sourceExtractionJobId": { "$ref": "common.schema.json#/$defs/uuid" },
    "contentType": { "type": "string", "minLength": 1, "maxLength": 128 },
    "documentTitle": { "anyOf": [{ "type": "string", "maxLength": 2048 }, { "type": "null" }] },
    "subtitle": { "anyOf": [{ "type": "string", "maxLength": 2048 }, { "type": "null" }] },
    "authors": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "publisher": { "anyOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }] },
    "publicationDate": { "anyOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }] },
    "modifiedDate": { "anyOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }] },
    "language": { "anyOf": [{ "type": "string", "maxLength": 16 }, { "type": "null" }] },
    "canonicalSourceLocator": { "anyOf": [{ "type": "string", "maxLength": 4096 }, { "type": "null" }] },
    "finalAcquiredLocator": { "anyOf": [{ "type": "string", "maxLength": 4096 }, { "type": "null" }] },
    "plainText": { "type": "string", "maxLength": 5000000 },
    "structuredSections": { "type": "array", "maxItems": 2000, "items": { "type": "object" } },
    "headings": { "type": "array", "maxItems": 2000, "items": { "type": "object" } },
    "paragraphs": { "type": "array", "maxItems": 20000, "items": { "type": "object" } },
    "lists": { "type": "array", "maxItems": 2000, "items": { "type": "object" } },
    "tables": { "type": "array", "maxItems": 500, "items": { "type": "object" } },
    "links": { "type": "array", "maxItems": 5000, "items": { "type": "object" } },
    "documentMetadata": { "type": "object", "maxProperties": 128 },
    "normalizationProfile": {
      "enum": ["HTML_ARTICLE_V1", "HTML_GENERIC_PAGE_V1", "PDF_DOCUMENT_V1", "OFFICE_DOCUMENT_V1", "PLAIN_TEXT_V1"]
    },
    "normalizationVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "normalizationProfileHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "normalizationInputHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "rawNormalizedTextHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "structuralContentHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "warnings": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 512 } },
    "qualityIndicators": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "enum": [
          "EMPTY_CONTENT",
          "LOW_TEXT_VOLUME",
          "MISSING_TITLE",
          "MISSING_DATE",
          "MISSING_AUTHOR",
          "STRUCTURE_UNAVAILABLE",
          "TABLE_EXTRACTION_WARNING",
          "ENCODING_WARNING",
          "TRUNCATED_OUTPUT",
          "UNSUPPORTED_LANGUAGE",
          "REQUIRES_ANALYST_REVIEW"
        ]
      }
    },
    "provenance": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "ruleId"],
        "properties": {
          "field": { "type": "string", "maxLength": 128 },
          "sourceArtifactId": { "anyOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
          "sourcePath": { "anyOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }] },
          "ruleId": { "type": "string", "maxLength": 128 }
        }
      }
    }
  }
}
