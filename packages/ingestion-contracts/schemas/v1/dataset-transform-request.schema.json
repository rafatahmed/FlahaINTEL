{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flahaintel.local/ingestion/v1/dataset-transform-request.schema.json",
  "title": "DatasetTransformRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "inputArtifacts", "outputStagingPrefix", "inputFormat", "targetFormat", "schemaMode", "declaredSchemaArtifact", "encodingHint", "csvOptions", "sheetSelection", "columnSelection", "providerOptions"],
  "properties": {
    "operation": { "const": "DATASET_TRANSFORM" },
    "inputArtifacts": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "artifact-reference.schema.json" } },
    "outputStagingPrefix": { "$ref": "common.schema.json#/$defs/relativeArtifactKey" },
    "inputFormat": { "enum": ["CSV", "JSON", "JSONL", "XLSX", "PARQUET"] },
    "targetFormat": { "const": "PARQUET" },
    "schemaMode": { "enum": ["INFER_AND_REPORT", "REQUIRE_DECLARED", "VALIDATE_DECLARED"] },
    "declaredSchemaArtifact": { "oneOf": [{ "$ref": "artifact-reference.schema.json" }, { "type": "null" }] },
    "encodingHint": { "type": ["string", "null"], "enum": ["UTF-8", "UTF-16LE", "WINDOWS-1252", null] },
    "csvOptions": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "properties": { "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 }, "hasHeader": { "type": "boolean" }, "quote": { "type": "string", "minLength": 1, "maxLength": 1 } } }] },
    "sheetSelection": { "oneOf": [{ "type": "null" }, { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255 } }] },
    "columnSelection": { "oneOf": [{ "type": "null" }, { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255 } }] },
    "providerOptions": { "type": "object", "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }, "maxProperties": 128 }
  }
}
