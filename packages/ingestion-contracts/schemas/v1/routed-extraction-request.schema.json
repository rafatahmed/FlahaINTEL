{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.flahaintel.local/ingestion/v1/routed-extraction-request.schema.json","title":"RoutedExtractionRequest","type":"object","additionalProperties":false,
  "required":["operation","outputStagingPrefix","executionId","capability","inputArtifact","outputAllocations","policyVersion","executionLimits","deadline","languageHints"],
  "properties":{
    "operation":{"enum":["HTML_EXTRACTION","DOCUMENT_EXTRACTION","DOCUMENT_INSPECTION"]},"outputStagingPrefix":{"type":"string","pattern":"^staging/[A-Za-z0-9._/-]+$","maxLength":512},"executionId":{"$ref":"common.schema.json#/$defs/uuid"},"capability":{"type":"string","pattern":"^(HTML|DOCUMENT)_[A-Z_]+$","maxLength":64},
