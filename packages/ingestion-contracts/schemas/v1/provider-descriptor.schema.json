{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flahaintel.local/ingestion/v1/provider-descriptor.schema.json",
  "title": "ProviderDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["providerId", "providerVersion", "adapterVersion", "contractVersions", "operations", "inputMediaTypes", "outputMediaTypes", "capabilities", "offlineCapable", "deterministicClaim", "requiresNetwork", "binaryDigest", "modelDigests", "generatedAt"],
  "properties": {
    "providerId": { "$ref": "common.schema.json#/$defs/providerId" },
    "providerVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "adapterVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "contractVersions": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/semanticVersion" } },
    "operations": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["DOCUMENT_CONVERSION", "CONTENT_EXTRACTION", "DATASET_TRANSFORM"] } },
    "inputMediaTypes": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/mediaType" } },
    "outputMediaTypes": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/mediaType" } },
    "capabilities": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "enum": ["OCR", "ARABIC", "TABLES", "LAYOUT", "IMAGES", "OFFLINE", "CANCELLATION"] } },
    "offlineCapable": { "type": "boolean" },
    "deterministicClaim": { "enum": ["DETERMINISTIC", "BEST_EFFORT", "NONDETERMINISTIC"] },
    "requiresNetwork": { "type": "boolean" },
    "binaryDigest": { "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "modelDigests": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/sha256" } },
    "generatedAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  }
}
