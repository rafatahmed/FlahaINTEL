{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flahaintel.local/ingestion/v1/document-conversion-request.schema.json",
  "title": "DocumentConversionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "inputArtifact", "outputStagingPrefix", "requestedOutputs", "documentProfile", "ocrMode", "languageHints", "textDirectionHint", "preserveLayout", "extractTables", "extractImages", "pageRange", "providerOptions"],
  "properties": {
    "operation": { "const": "DOCUMENT_CONVERSION" },
    "inputArtifact": { "$ref": "artifact-reference.schema.json" },
    "outputStagingPrefix": { "$ref": "common.schema.json#/$defs/relativeArtifactKey" },
    "requestedOutputs": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["PROVIDER_JSON", "MARKDOWN", "PAGE_IMAGES", "TABLES", "EXTRACTED_IMAGES"] } },
    "documentProfile": { "enum": ["GENERAL", "RESEARCH_PAPER", "REPORT", "REGULATION", "TENDER"] },
    "ocrMode": { "enum": ["DISABLED", "AUTO", "REQUIRED"] },
    "languageHints": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/languageTag" } },
    "textDirectionHint": { "enum": ["AUTO", "LTR", "RTL", "MIXED"] },
    "preserveLayout": { "type": "boolean" },
    "extractTables": { "type": "boolean" },
    "extractImages": { "type": "boolean" },
    "pageRange": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "type": "integer", "minimum": 1, "maximum": 100000 }, "end": { "type": "integer", "minimum": 1, "maximum": 100000 } } }
      ]
    },
    "providerOptions": { "type": "object", "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null" ] }, "maxProperties": 128, "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]{0,63}$" } }
  }
}
