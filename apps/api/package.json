{
  "name": "@flaha-intel/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "test": "vitest run src",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "taxonomy:validate": "tsx src/taxonomy/validateTaxonomies.ts"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@prisma/client": "6.19.0",
    "fastify": "latest",
    "rss-parser": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prisma": "6.19.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
