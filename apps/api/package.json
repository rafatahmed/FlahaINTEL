{
  "name": "@flaha-intel/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "test": "vitest run src",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "taxonomy:validate": "tsx src/taxonomy/validateTaxonomies.ts",
    "governance:seed": "node --env-file=../../.env --import tsx src/governance/seedGovernedData.ts",
    "governance:backfill-sources": "node --env-file=../../.env --import tsx src/governance/backfillSourceMetadata.ts"
    ,"ingest:create-acquisition": "node --env-file=../../.env --import tsx src/acquisition/cli.ts create"
    ,"ingest:worker:once": "node --env-file=../../.env --import tsx src/acquisition/cli.ts worker-once"
    ,"ingest:job": "node --env-file=../../.env --import tsx src/acquisition/cli.ts job"
    ,"ingest:artifact": "node --env-file=../../.env --import tsx src/acquisition/cli.ts artifact"
  },
  "dependencies": {
    "@flaha-intel/artifact-store": "0.1.0",
    "@flaha-intel/ingestion-provider-core": "0.1.0",
    "@flaha-intel/worker-supervisor": "0.1.0",
    "@fastify/cors": "latest",
    "@prisma/client": "6.19.0",
    "fastify": "latest",
    "rss-parser": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prisma": "6.19.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
