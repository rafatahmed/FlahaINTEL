generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollectionStatus {
  SUCCESS
  FAILURE
}

enum ClassificationType {
  GENERAL_DOMAIN
  GENERAL_EVENT_TYPE
  SECTOR
  AGRICULTURE_DOMAIN
  PRODUCT_CATEGORY
  TECHNOLOGY_CATEGORY
  MARKET_CATEGORY
  IMPACT_TYPE
  RELEVANCE_TARGET
  GEOGRAPHIC_SCOPE
}

enum AssignmentProvenance {
  MANUAL
  RULE_BASED
  IMPORTED
}

enum SourceAuthorityType {
  INTERGOVERNMENTAL_ORGANIZATION
  GOVERNMENT_AGENCY
  REGULATORY_AUTHORITY
  PUBLIC_SERVICE_MEDIA
  COMMERCIAL_MEDIA
  RESEARCH_INSTITUTION
  UNIVERSITY
  NON_GOVERNMENTAL_ORGANIZATION
  INDUSTRY_ASSOCIATION
  COMMERCIAL_ORGANIZATION
  DATA_PROVIDER
  OTHER
}

enum SourceVerificationStatus {
  PENDING
  ACCEPTED
  DEGRADED
  REJECTED
}

enum ProductEntityEligibility {
  CLASSIFICATION_ONLY
  COMMERCIAL_PRODUCT
}

enum OrganizationProductRole {
  MANUFACTURER
  BRAND_OWNER
  DEVELOPER
  DISTRIBUTOR
  SUPPLIER
  IMPORTER
}

enum IngestionJobType {
  DATASET_VALIDATION
  HTML_EXTRACTION
  DOCUMENT_PROCESSING
  STATIC_ACQUISITION
  BROWSER_ACQUISITION
}

enum IngestionJobState {
  PENDING
  READY
  LEASED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  DEAD_LETTER
}

enum IngestionAttemptState {
  CREATED
  LEASED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
  LEASE_EXPIRED
  CONTRACT_REJECTED
}

enum IngestionActorType {
  SYSTEM
  API
  SCHEDULER
  WORKER
  ADMIN
  RECOVERY
}

enum IngestionPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum IngestionArtifactRelationship {
  INPUT
  RAW_RESPONSE
  RENDERED_HTML
  EXTRACTED_TEXT
  METADATA
  TABLE
  STRUCTURE
  DIAGNOSTIC
  RESULT
}

model RssSource {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String
  url                String                   @unique
  enabled            Boolean                  @default(true)
  registryId         String?                  @unique
  publisher          String?
  category           String?
  region             String?
  language           String?
  authorityType      SourceAuthorityType?
  verificationStatus SourceVerificationStatus @default(PENDING)
  homepageUrl        String?
  evidenceUrl        String?
  ownershipVerified  Boolean?
  lastCollectedAt    DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  articles           Article[]
  collectionRuns     CollectionRun[]
  governanceCandidates GovernanceCandidate[]
  sourceGovernancePolicies SourceGovernancePolicy[]
  productSubmissions ProductSubmission[]

  @@index([enabled])
}

model Article {
  id              String                  @id @default(uuid()) @db.Uuid
  sourceId        String                  @db.Uuid
  source          RssSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title           String
  url             String
  summary         String?
  author          String?
  publishedAt     DateTime?
  collectedAt     DateTime                @default(now())
  fingerprint     String                  @unique
  classifications ArticleClassification[]
  eventEvidence   EventEvidence[]
  organizations   ArticleOrganization[]
  products        ArticleProduct[]

  @@index([sourceId])
  @@index([publishedAt])
  @@index([collectedAt])
}

model CollectionRun {
  id         String           @id @default(uuid()) @db.Uuid
  sourceId   String           @db.Uuid
  source     RssSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status     CollectionStatus
  startedAt  DateTime         @default(now())
  finishedAt DateTime
  itemsFound Int              @default(0)
  itemsAdded Int              @default(0)
  error      String?

  @@index([sourceId, startedAt])
}

model ClassificationTerm {
  id                  String                    @id @default(uuid()) @db.Uuid
  type                ClassificationType
  code                String
  label               String
  description         String?
  parentId            String?                   @db.Uuid
  parent              ClassificationTerm?       @relation("ClassificationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            ClassificationTerm[]      @relation("ClassificationHierarchy")
  standardCode        String?
  aliases             String[]                  @default([])
  entityEligibility   ProductEntityEligibility?
  assignable          Boolean                   @default(true)
  active              Boolean                   @default(true)
  sortOrder           Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  articleAssignments  ArticleClassification[]
  eventAssignments    EventClassification[]
  primaryEvents       IntelligenceEvent[]
  categorizedProducts Product[]

  @@unique([type, code])
  @@unique([type, standardCode])
  @@index([type, active, sortOrder])
  @@index([parentId])
}

model ArticleClassification {
  articleId     String               @db.Uuid
  termId        String               @db.Uuid
  article       Article              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  term          ClassificationTerm   @relation(fields: [termId], references: [id], onDelete: Restrict)
  provenance    AssignmentProvenance
  provenanceRef String?
  confidence    Decimal?             @db.Decimal(5, 4)
  assignedAt    DateTime             @default(now())

  @@id([articleId, termId])
  @@index([termId])
  @@index([provenance])
}

model IntelligenceEvent {
  id                     String                @id @default(uuid()) @db.Uuid
  primaryEventTypeTermId String                @db.Uuid
  primaryEventType       ClassificationTerm    @relation(fields: [primaryEventTypeTermId], references: [id], onDelete: Restrict)
  title                  String
  summary                String?
  startsAt               DateTime?
  endsAt                 DateTime?
  observedAt             DateTime?
  locationName           String?
  active                 Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  classifications        EventClassification[]
  evidence               EventEvidence[]

  @@index([primaryEventTypeTermId])
  @@index([startsAt])
  @@index([observedAt])
}

model EventClassification {
  eventId       String               @db.Uuid
  termId        String               @db.Uuid
  event         IntelligenceEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  term          ClassificationTerm   @relation(fields: [termId], references: [id], onDelete: Restrict)
  provenance    AssignmentProvenance
  provenanceRef String?
  confidence    Decimal?             @db.Decimal(5, 4)
  assignedAt    DateTime             @default(now())

  @@id([eventId, termId])
  @@index([termId])
  @@index([provenance])
}

model EventEvidence {
  eventId   String            @db.Uuid
  articleId String            @db.Uuid
  event     IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  article   Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  addedAt   DateTime          @default(now())

  @@id([eventId, articleId])
  @@index([articleId])
}

model OrganizationType {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  label         String
  description   String?
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
}

model Organization {
  id             String                @id @default(uuid()) @db.Uuid
  typeId         String                @db.Uuid
  type           OrganizationType      @relation(fields: [typeId], references: [id], onDelete: Restrict)
  canonicalName  String
  normalizedName String
  homepageUrl    String?
  countryCode    String?
  region         String?
  description    String?
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  articles       ArticleOrganization[]
  products       OrganizationProduct[]

  @@index([typeId])
  @@index([normalizedName])
  @@index([countryCode])
}

model Product {
  id             String                @id @default(uuid()) @db.Uuid
  code           String                @unique
  name           String
  categoryTermId String                @db.Uuid
  category       ClassificationTerm    @relation(fields: [categoryTermId], references: [id], onDelete: Restrict)
  description    String?
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  articles       ArticleProduct[]
  organizations  OrganizationProduct[]

  @@index([categoryTermId])
}

model ArticleOrganization {
  articleId      String       @db.Uuid
  organizationId String       @db.Uuid
  article        Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  linkedAt       DateTime     @default(now())

  @@id([articleId, organizationId])
  @@index([organizationId])
}

model ArticleProduct {
  articleId String   @db.Uuid
  productId String   @db.Uuid
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  linkedAt  DateTime @default(now())

  @@id([articleId, productId])
  @@index([productId])
}

model OrganizationProduct {
  organizationId String                  @db.Uuid
  productId      String                  @db.Uuid
  role           OrganizationProductRole
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt      DateTime                @default(now())

  @@id([organizationId, productId, role])
  @@index([productId])
  @@index([role])
}

model IngestionJob {
  id                  String                   @id @default(uuid()) @db.Uuid
  jobType             IngestionJobType
  state               IngestionJobState        @default(PENDING)
  priority            IngestionPriority        @default(NORMAL)
  idempotencyKey      String                   @unique
  requestFingerprint  String                   @db.Char(64)
  requestedCapability String
  providerFamily      String
  requestedProviderId String?
  selectedProviderId  String?
  selectionDecision   Json
  requestEnvelope     Json
  policySnapshot      Json
  executionLimits     Json
  inputArtifactId     String?                  @db.Uuid
  sourceLocator       Json?
  languageHints       String[]                 @default([])
  mediaType           String
  attemptCount        Int                      @default(0)
  maxAttempts         Int                      @default(3)
  nextAttemptAt       DateTime?
  cancelRequestedAt   DateTime?
  cancelledAt         DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  version             Int                      @default(0)
  attempts            IngestionAttempt[]
  transitions         IngestionJobTransition[]
  artifacts           IngestionArtifactLink[]
  provenance          IngestionProvenance[]
  candidatesAsAcquisition  GovernanceCandidate[] @relation("CandidateAcquisitionJob")
  candidatesAsExtraction   GovernanceCandidate[] @relation("CandidateExtractionJob")
  candidatesAsNormalization GovernanceCandidate[] @relation("CandidateNormalizationJob")

  @@index([state, nextAttemptAt, priority, createdAt], map: "IngestionJob_claimable_idx")
  @@index([selectedProviderId])
  @@index([requestedCapability])
}

model IngestionAttempt {
  id               String                   @id @default(uuid()) @db.Uuid
  jobId            String                   @db.Uuid
  job              IngestionJob             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  attemptNumber    Int
  state            IngestionAttemptState    @default(CREATED)
  providerId       String
  providerVersion  String
  capability       String
  selectionReason  String
  fallbackReason   String?
  leaseOwner       String?
  leaseTokenHash   String?                  @db.Char(64)
  leasedAt         DateTime?
  leaseExpiresAt   DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  heartbeatAt      DateTime?
  requestEnvelope  Json
  resultEnvelope   Json?
  errorCode        String?
  errorDetails     Json?
  retryable        Boolean?
  fallbackEligible Boolean?
  securityRelevant Boolean?
  metrics          Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  transitions      IngestionJobTransition[]
  artifacts        IngestionArtifactLink[]
  provenance       IngestionProvenance?

  @@unique([jobId, attemptNumber])
  @@index([jobId, state])
  @@index([state, leaseExpiresAt], map: "IngestionAttempt_expired_lease_idx")
}

model IngestionJobTransition {
  id            String             @id @default(uuid()) @db.Uuid
  jobId         String             @db.Uuid
  job           IngestionJob       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  attemptId     String?            @db.Uuid
  attempt       IngestionAttempt?  @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  fromState     IngestionJobState?
  toState       IngestionJobState
  reasonCode    String
  reasonDetail  String?
  actorType     IngestionActorType
  actorId       String
  correlationId String
  createdAt     DateTime           @default(now())

  @@index([jobId, createdAt])
  @@index([attemptId])
}

model IngestionArtifactLink {
  id           String                        @id @default(uuid()) @db.Uuid
  jobId        String                        @db.Uuid
  job          IngestionJob                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  attemptId    String?                       @db.Uuid
  attempt      IngestionAttempt?             @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  artifactId   String                        @db.Uuid
  relationship IngestionArtifactRelationship
  mediaType    String
  sha256       String                        @db.Char(64)
  byteSize     BigInt
  createdAt    DateTime                      @default(now())

  @@unique([jobId, attemptId, artifactId, relationship])
  @@index([jobId, attemptId])
  @@index([artifactId])
}

model IngestionProvenance {
  id                        String           @id @default(uuid()) @db.Uuid
  jobId                     String           @db.Uuid
  job                       IngestionJob     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  attemptId                 String           @unique @db.Uuid
  attempt                   IngestionAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  providerId                String
  providerVersion           String
  contractVersion           String
  capability                String
  policyVersion             String
  selectionSnapshot         Json
  fallbackHistory           Json
  runtimeEvidence           Json
  inputHashes               String[]         @default([])
  outputHashes              String[]         @default([])
  determinismClassification String
  startedAt                 DateTime
  completedAt               DateTime
  createdAt                 DateTime         @default(now())

  @@index([jobId, attemptId])
}

// ---------------------------------------------------------------------------
// Phase 3K — Governance, Review and Promotion
// ---------------------------------------------------------------------------

enum GovernanceRole {
  VIEWER
  ANALYST
  REVIEWER
  GOVERNANCE_ADMIN
}

enum GovernanceReviewState {
  PENDING_EVALUATION
  READY_FOR_REVIEW
  NEEDS_CORRECTION
  ON_HOLD
  APPROVED
  REJECTED
  PROMOTION_ELIGIBLE
  PROMOTED
  WITHDRAWN
}

enum GovernancePromotionState {
  NOT_EVALUATED
  ELIGIBLE
  INELIGIBLE
  INVALIDATED
  PROMOTED
}

enum EvidenceCompleteness {
  COMPLETE
  PARTIAL
  INSUFFICIENT
  CONFLICTING
}

enum GovernanceAction {
  EVALUATE
  ASSIGN
  APPROVE
  REJECT
  REQUEST_CORRECTION
  PLACE_ON_HOLD
  RELEASE_HOLD
  WITHDRAW_APPROVAL
  MARK_PROMOTION_ELIGIBLE
  MARK_PROMOTED
  WITHDRAW
  SUPERSEDE
}

enum GovernanceAssignmentState {
  ACTIVE
  RELEASED
  SUPERSEDED
}

enum SourceGovernanceStatus {
  ACTIVE
  SUSPENDED
  RETIRED
  UNDER_REVIEW
}

enum TrustTier {
  UNTRUSTED
  LOW
  STANDARD
  HIGH
  AUTHORITATIVE
}

enum CandidateRelationshipType {
  EXACT_DUPLICATE
  LIKELY_DUPLICATE
  UPDATED_VERSION
  SUPERSEDES
  SUPERSEDED_BY
  CORRECTION_OF
}

enum EligibilityState {
  ELIGIBLE
  INELIGIBLE
  INVALIDATED
}

enum ReviewPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model UserAccount {
  id          String             @id @default(uuid()) @db.Uuid
  email       String             @unique
  displayName String
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  decisions   GovernanceDecision[] @relation("DecisionActor")
  assignmentsMade GovernanceAssignment[] @relation("AssignmentAssignedBy")
  assignmentsReceived GovernanceAssignment[] @relation("AssignmentReviewer")
  eligibilityEvaluations PromotionEligibility[] @relation("EligibilityEvaluator")
  sourcePoliciesOwned SourceGovernancePolicy[] @relation("SourcePolicyOwner")
  submissions ProductSubmission[] @relation("SubmissionCreator")
  marketPricesCreated MarketPriceObservation[] @relation("MarketPriceCreator")
  marketPricesReviewed MarketPriceObservation[] @relation("MarketPriceReviewer")
  knowledgePacksOwned KnowledgePack[] @relation("KnowledgePackOwner")
  flahaSoilComparisonsCreated FlahaSoilComparisonCase[] @relation("FlahaSoilComparisonCreator")
  flahaSoilComparisonsReviewed FlahaSoilComparisonCase[] @relation("FlahaSoilComparisonReviewer")
  evidenceIntakesCreated EvidenceIntake[] @relation("EvidenceIntakeCreator")
  productFeedPoliciesUpdated ProductFeedPolicy[] @relation("ProductFeedPolicyUpdater")
  productHandoffExports ProductHandoffExport[] @relation("ProductHandoffExporter")
  researchIndexRebuilds ResearchIndexRebuild[] @relation("ResearchIndexRebuildActor")

  @@index([active])
}

model Tenant {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique
  name        String
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  candidates  GovernanceCandidate[]
  sourcePolicies SourceGovernancePolicy[]
  decisions   GovernanceDecision[]
  submissions ProductSubmission[]
  marketPriceObservations MarketPriceObservation[]
  marketDaySummaries MarketDaySummary[]
  knowledgePacks KnowledgePack[]
  flahaSoilComparisons FlahaSoilComparisonCase[]
  evidenceIntakes EvidenceIntake[]
  productFeedPolicies ProductFeedPolicy[]
  productHandoffExports ProductHandoffExport[]
  researchTopics ResearchTopic[]

  @@index([active])
}

model TenantMembership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  tenantId  String         @db.Uuid
  role      GovernanceRole
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      UserAccount    @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@index([userId, active])
}

model GovernanceCandidate {
  id                      String                    @id @default(uuid()) @db.Uuid
  tenantId                String                    @db.Uuid
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  normalizedArtifactId    String                    @db.Uuid
  normalizedContentHash   String                    @db.Char(64)
  sourceId                String?                   @db.Uuid
  source                  RssSource?                @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceAcquisitionJobId  String?                   @db.Uuid
  sourceAcquisitionJob    IngestionJob?             @relation("CandidateAcquisitionJob", fields: [sourceAcquisitionJobId], references: [id], onDelete: SetNull)
  sourceExtractionJobId   String?                   @db.Uuid
  sourceExtractionJob     IngestionJob?             @relation("CandidateExtractionJob", fields: [sourceExtractionJobId], references: [id], onDelete: SetNull)
  sourceNormalizationJobId String                   @db.Uuid
  sourceNormalizationJob  IngestionJob              @relation("CandidateNormalizationJob", fields: [sourceNormalizationJobId], references: [id], onDelete: Restrict)
  contentType             String
  language                String
  normalizationProfile    String
  normalizationVersion    String
  evidenceCompleteness    EvidenceCompleteness      @default(INSUFFICIENT)
  evidenceReasons         Json                      @default("[]")
  reviewState             GovernanceReviewState     @default(PENDING_EVALUATION)
  promotionState          GovernancePromotionState  @default(NOT_EVALUATED)
  priority                ReviewPriority            @default(NORMAL)
  assignedReviewerId      String?                   @db.Uuid
  candidateVersion        Int                       @default(1)
  currentDecisionVersion  Int                       @default(0)
  version                 Int                       @default(0)
  titlePreview            String?
  warningSummary          Json                      @default("[]")
  qualityIndicators       Json                      @default("[]")
  checkResults            Json                      @default("[]")
  documentTitle           String?
  supersededByCandidateId String?                   @db.Uuid
  supersededByCandidate   GovernanceCandidate?      @relation("CandidateSupersession", fields: [supersededByCandidateId], references: [id], onDelete: SetNull)
  supersedesCandidates    GovernanceCandidate[]     @relation("CandidateSupersession")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  decisions               GovernanceDecision[]
  assignments             GovernanceAssignment[]
  eligibilityRecords      PromotionEligibility[]
  relationshipsFrom       CandidateRelationship[]   @relation("RelationshipFrom")
  relationshipsTo         CandidateRelationship[]   @relation("RelationshipTo")

  @@unique([normalizedArtifactId, candidateVersion])
  @@unique([sourceNormalizationJobId, candidateVersion])
  @@index([tenantId, reviewState, priority])
  @@index([tenantId, promotionState])
  @@index([tenantId, evidenceCompleteness])
  @@index([assignedReviewerId, reviewState])
  @@index([sourceId])
  @@index([language])
  @@index([contentType])
  @@index([normalizedContentHash])
  @@index([createdAt])
}

model GovernanceDecision {
  id                   String                @id @default(uuid()) @db.Uuid
  candidateId          String                @db.Uuid
  candidate            GovernanceCandidate   @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  previousState        GovernanceReviewState?
  newState             GovernanceReviewState
  action               GovernanceAction
  actorId              String                @db.Uuid
  actor                UserAccount           @relation("DecisionActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorTenantId        String                @db.Uuid
  actorTenant          Tenant                @relation(fields: [actorTenantId], references: [id], onDelete: Restrict)
  reasonCode           String
  note                 String?               @db.VarChar(2000)
  reviewedContentHash  String                @db.Char(64)
  candidateVersion     Int
  decisionSequence     Int
  policyVersion        Int?
  idempotencyKey       String
  correlationId        String
  createdAt            DateTime              @default(now())

  @@unique([candidateId, decisionSequence])
  @@unique([idempotencyKey])
  @@index([candidateId, createdAt])
  @@index([actorId, createdAt])
  @@index([actorTenantId])
}

model GovernanceAssignment {
  id               String                     @id @default(uuid()) @db.Uuid
  candidateId      String                     @db.Uuid
  candidate        GovernanceCandidate        @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  reviewerId       String                     @db.Uuid
  reviewer         UserAccount                @relation("AssignmentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  assignedById     String                     @db.Uuid
  assignedBy       UserAccount                @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  assignmentState  GovernanceAssignmentState  @default(ACTIVE)
  assignmentVersion Int
  reasonCode       String?
  note             String?                    @db.VarChar(2000)
  idempotencyKey   String                     @unique
  correlationId    String
  createdAt        DateTime                   @default(now())
  releasedAt       DateTime?

  @@unique([candidateId, assignmentVersion])
  @@index([candidateId, assignmentState])
  @@index([reviewerId, assignmentState])
}

model SourceGovernancePolicy {
  id                      String                 @id @default(uuid()) @db.Uuid
  sourceId                String                 @db.Uuid
  source                  RssSource              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  tenantId                String                 @db.Uuid
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceStatus            SourceGovernanceStatus @default(ACTIVE)
  allowedAcquisitionModes String[]               @default([])
  allowedContentTypes     String[]               @default([])
  allowedLanguages        String[]               @default([])
  reviewRequirement       String                 @default("ANALYST_REVIEW_REQUIRED")
  promotionRequirement    String                 @default("APPROVED_AND_POLICY_PERMITTED")
  retentionPolicy         String                 @default("STANDARD_GOVERNANCE_RETENTION")
  sensitivityClassification String               @default("INTERNAL")
  trustTier               TrustTier             @default(STANDARD)
  ownerUserId             String?                @db.Uuid
  owner                   UserAccount?           @relation("SourcePolicyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  effectiveAt             DateTime               @default(now())
  reviewDueAt             DateTime?
  version                 Int                    @default(1)
  reasonCode              String?
  correlationId           String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([tenantId, sourceId])
  @@index([sourceId])
  @@index([tenantId, sourceStatus])
  @@index([trustTier])
}

model PromotionEligibility {
  id                   String               @id @default(uuid()) @db.Uuid
  candidateId          String               @db.Uuid
  candidate            GovernanceCandidate  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  eligibilityState     EligibilityState
  evaluatedContentHash String               @db.Char(64)
  policyVersion        Int?
  evidenceSnapshot     Json
  blockers             Json                 @default("[]")
  evaluatedAt          DateTime             @default(now())
  evaluatorId          String               @db.Uuid
  evaluator            UserAccount          @relation("EligibilityEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)
  eligibilityVersion   Int
  invalidationReason   String?
  invalidatedAt        DateTime?
  createdAt            DateTime             @default(now())

  @@unique([candidateId, eligibilityVersion])
  @@index([candidateId, eligibilityState])
  @@index([evaluatedContentHash])
}

model CandidateRelationship {
  id               String                     @id @default(uuid()) @db.Uuid
  fromCandidateId  String                     @db.Uuid
  fromCandidate    GovernanceCandidate        @relation("RelationshipFrom", fields: [fromCandidateId], references: [id], onDelete: Restrict)
  toCandidateId    String                     @db.Uuid
  toCandidate      GovernanceCandidate        @relation("RelationshipTo", fields: [toCandidateId], references: [id], onDelete: Restrict)
  relationshipType CandidateRelationshipType
  createdById      String                     @db.Uuid
  reasonCode       String
  note             String?                    @db.VarChar(2000)
  idempotencyKey   String                     @unique
  correlationId    String
  createdAt        DateTime                   @default(now())

  @@unique([fromCandidateId, toCandidateId, relationshipType])
  @@index([toCandidateId, relationshipType])
  @@index([fromCandidateId, relationshipType])
}

// ---------------------------------------------------------------------------
// Phase 3L — Product submissions and stage tracking
// ---------------------------------------------------------------------------

enum ProductSubmissionType {
  WEBSITE_URL
  DOCUMENT_UPLOAD
  RSS_SOURCE
}

enum ProductSubmissionStatus {
  ACCEPTED
  RUNNING
  WAITING_MANUAL
  SUCCEEDED
  FAILED
  CANCELLED
  REJECTED
}

enum ProductSubmissionStageKind {
  INPUT
  ACQUISITION
  EXTRACTION
  NORMALIZATION
  GOVERNANCE
}

enum ProductSubmissionStageStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
  REJECTED
}

enum ProductChainMode {
  AUTO_CHAIN
  MANUAL_STAGE
}

model ProductSubmission {
  id                     String                   @id @default(uuid()) @db.Uuid
  tenantId               String                   @db.Uuid
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submissionType         ProductSubmissionType
  overallStatus          ProductSubmissionStatus  @default(ACCEPTED)
  currentStage           ProductSubmissionStageKind @default(INPUT)
  chainMode              ProductChainMode         @default(AUTO_CHAIN)
  sourceId               String?                  @db.Uuid
  source                 RssSource?               @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceLocator          Json?
  inputArtifactId        String?                  @db.Uuid
  inputArtifactSha256    String?                  @db.Char(64)
  inputMediaType         String?
  inputByteSize          BigInt?
  languageHint           String                   @default("en")
  acquisitionMode        String?
  acquisitionJobId       String?                  @db.Uuid
  extractionJobId        String?                  @db.Uuid
  normalizationJobId     String?                  @db.Uuid
  governanceCandidateId  String?                  @db.Uuid
  createdById            String                   @db.Uuid
  createdBy              UserAccount              @relation("SubmissionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  correlationId          String
  idempotencyKey         String                   @unique
  lastErrorCode          String?
  lastErrorMessage       String?                  @db.VarChar(2000)
  titlePreview           String?
  version                Int                      @default(0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  stages                 ProductSubmissionStage[]

  @@index([tenantId, overallStatus, createdAt])
  @@index([tenantId, currentStage])
  @@index([correlationId])
  @@index([acquisitionJobId])
  @@index([extractionJobId])
  @@index([normalizationJobId])
  @@index([governanceCandidateId])
  @@index([createdById])
}

model ProductSubmissionStage {
  id              String                       @id @default(uuid()) @db.Uuid
  submissionId    String                       @db.Uuid
  submission      ProductSubmission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  stageKind       ProductSubmissionStageKind
  status          ProductSubmissionStageStatus @default(PENDING)
  sequence        Int
  jobId           String?                      @db.Uuid
  artifactId      String?                      @db.Uuid
  candidateId     String?                      @db.Uuid
  errorCode       String?
  errorMessage    String?                      @db.VarChar(2000)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@unique([submissionId, stageKind])
  @@unique([submissionId, sequence])
  @@index([jobId])
  @@index([status])
}

// --- Phase 4M / 4S: global market prices + knowledge packs (final product eyes/muscles) ---

enum MarketChannelVerificationStatus {
  PENDING
  ACCEPTED
  DEGRADED
  REJECTED
}

enum MarketPriceReviewState {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Channel-level policy for harvest-time review (human remains in charge of the policy).
enum MarketChannelReviewMode {
  /// Default: every harvested/updated row enters PENDING_REVIEW for a human.
  HUMAN_REQUIRED
  /// Trusted official channels may auto-approve when ACCEPTED + ownershipVerified.
  /// Admin can flip back to HUMAN_REQUIRED at any time. Not silent unlimited publish.
  AUTO_APPROVE_OFFICIAL
}

/// How the current reviewState was decided (audit trail for auto vs human).
enum MarketPriceReviewDecisionSource {
  /// Still pending human review (or never decided).
  NONE
  /// A human reviewer approved or rejected.
  HUMAN
  /// Channel policy AUTO_APPROVE_OFFICIAL applied at harvest/record.
  CHANNEL_POLICY
}

enum KnowledgePackTheme {
  SOIL
  IRRIGATION
  NUTRITION
  DIGITAL_PLATFORM
  MARKET_CONTEXT
  OTHER
}

enum KnowledgePackReviewState {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

/// Global market channel (country-agnostic product; country is a field).
model MarketChannel {
  id                 String                         @id @default(uuid()) @db.Uuid
  code               String                         @unique
  countryCode        String
  marketCode         String
  name               String
  publisher          String
  authorityType      SourceAuthorityType?
  officialUrl        String
  homepageUrl        String?
  evidenceUrl        String?
  ownershipVerified  Boolean                        @default(false)
  verificationStatus MarketChannelVerificationStatus @default(PENDING)
  enabled            Boolean                        @default(true)
  language           String                         @default("en")
  currencyDefault    String                         @default("QAR")
  /// Harvest cadence in days (Jordan daily = 1; Qatar Mahaseel/MoCI = 3).
  harvestIntervalDays Int                           @default(1)
  /// Max inclusive day span for filter queries (Jordan product filter window = 3).
  filterMaxSpanDays   Int                           @default(3)
  /// Policy: human review queue vs auto-approve official bulletins (policy-driven, not silent).
  reviewMode         MarketChannelReviewMode        @default(HUMAN_REQUIRED)
  notes              String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  prices             MarketPriceObservation[]
  daySummaries       MarketDaySummary[]

  @@unique([countryCode, marketCode])
  @@index([countryCode, enabled])
  @@index([verificationStatus])
  @@index([reviewMode])
}

/// One price row for a commodity on a bulletin date (tenant-scoped for multi-tenant product).
/// Supports simple channels (Mahaseel: period PDF, unit price) and comprehensive channels
/// (Amman: high/mode/low in native units e.g. qrsh, bilingual names, tons).
model MarketPriceObservation {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  channelId        String                @db.Uuid
  channel          MarketChannel         @relation(fields: [channelId], references: [id], onDelete: Restrict)
  /// Primary calendar day for the price (Jordan daily; Mahaseel often period end).
  observedOn       DateTime              @db.Date
  /// Optional bulletin period (Mahaseel from–to).
  periodFrom       DateTime?             @db.Date
  periodTo         DateTime?             @db.Date
  commodityCode    String
  commodityName    String
  commodityNameAr  String?
  commodityNameEn  String?
  originLabel      String?
  unit             String
  packDescription  String                @default("")
  packPrice        Decimal?              @db.Decimal(18, 4)
  unitPrice        Decimal?              @db.Decimal(18, 4)
  /// Amman: highest / most-common / minimum (canonical currency after conversion).
  priceHigh        Decimal?              @db.Decimal(18, 4)
  priceMode        Decimal?              @db.Decimal(18, 4)
  priceLow         Decimal?              @db.Decimal(18, 4)
  /// Native quote unit when UI is not ISO currency (e.g. QRSH where 1 QRSH = 0.01 JOD).
  nativePriceUnit  String?
  nativeToCurrencyFactor Decimal?        @db.Decimal(18, 6)
  priceHighNative  Decimal?              @db.Decimal(18, 4)
  priceModeNative  Decimal?              @db.Decimal(18, 4)
  priceLowNative   Decimal?              @db.Decimal(18, 4)
  currency         String
  grade            String?
  cultivationMethod String?
  quantityTons     Decimal?              @db.Decimal(18, 3)
  evidenceUrl      String?
  evidenceArtifactId String?             @db.Uuid
  sourceBatchId    String
  contentFingerprint String              @unique
  reviewState      MarketPriceReviewState @default(PENDING_REVIEW)
  /// NONE while pending; HUMAN after governance review; CHANNEL_POLICY after auto-approve.
  reviewDecisionSource MarketPriceReviewDecisionSource @default(NONE)
  reviewedById     String?               @db.Uuid
  reviewedBy       UserAccount?          @relation("MarketPriceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?
  createdById      String                @db.Uuid
  createdBy        UserAccount           @relation("MarketPriceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  correlationId    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([channelId, observedOn, commodityCode, unit, currency, packDescription, originLabel])
  @@index([tenantId, channelId, observedOn])
  @@index([tenantId, commodityCode, observedOn])
  @@index([tenantId, reviewState])
  @@index([tenantId, reviewDecisionSource])
  @@index([sourceBatchId])
}

/// Optional market-day aggregates (e.g. Amman total tons by vegetables/fruit/leafy).
model MarketDaySummary {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  channelId   String        @db.Uuid
  channel     MarketChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  observedOn  DateTime      @db.Date
  originLabel String        @default("")
  category    String
  quantityTons Decimal      @db.Decimal(18, 3)
  unitLabel   String        @default("tons")
  evidenceUrl String?
  sourceBatchId String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([channelId, observedOn, originLabel, category])
  @@index([tenantId, channelId, observedOn])
}

/// Universal PA knowledge pack (soil/irrigation/…); place is tags only.
model KnowledgePack {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  theme       KnowledgePackTheme
  title       String
  summary     String?
  cropTags    String[]                @default([])
  regionTags  String[]                @default([])
  climateTags String[]                @default([])
  language    String                  @default("en")
  reviewState KnowledgePackReviewState @default(DRAFT)
  version     Int                     @default(1)
  ownerUserId String                  @db.Uuid
  owner       UserAccount             @relation("KnowledgePackOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  items       KnowledgePackItem[]

  @@unique([tenantId, code])
  @@index([tenantId, theme, reviewState])
  @@index([ownerUserId])
}

model KnowledgePackItem {
  id                    String        @id @default(uuid()) @db.Uuid
  packId                String        @db.Uuid
  pack                  KnowledgePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  sequence              Int
  title                 String
  extractKind           String
  bodyText              String?
  structured            Json          @default("{}")
  sourceUrl             String?
  evidenceArtifactId    String?       @db.Uuid
  governanceCandidateId String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([packId, sequence])
  @@index([packId])
}

/// Gate 4S-D: human FlahaSOIL comparison / deviation case (never auto-writes product).
enum FlahaSoilComparisonStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  PRODUCT_TICKET_OPEN
  CLOSED
}

model FlahaSoilComparisonCase {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code      String
  title     String

  /// FlahaSOIL wire key (e.g. ecDsM, pH, sar)
  parameter String
  unit      String?
  soilTestLevels   String[] @default([])
  appliesFromLevel String?

  literatureValue    Float?
  literatureValueMin Float?
  literatureValueMax Float?
  literatureRange    String?
  literatureOperator String?
  literatureSource   String?
  thresholdPackItemId String? @db.Uuid

  flahaSoilObservation  String?
  flahaSoilValue        Float?
  flahaSoilReportNumber String?
  flahaSoilTestLevel    String?
  flahaSoilSampleRef    String?

  deviationSummary         String
  recommendedHumanAction   String
  autoApplyBlocked         Boolean @default(true)
  doesNotAutoUpdateFlahaSOIL Boolean @default(true)

  status           FlahaSoilComparisonStatus @default(DRAFT)
  productTicketRef String?
  version          Int                       @default(1)

  createdById  String      @db.Uuid
  createdBy    UserAccount @relation("FlahaSoilComparisonCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById String?     @db.Uuid
  reviewedBy   UserAccount? @relation("FlahaSoilComparisonReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, parameter])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Evidence Intake Spine (central Submit): land once → classify → promote
// ---------------------------------------------------------------------------

/// What the human says this evidence is (routes promote, not re-upload).
enum EvidenceIntakeClass {
  UNCLASSIFIED
  EYES_WEBSITE
  EYES_DOCUMENT
  MARKET_MAHASEEL_PDF
  MARKET_JO_AMMAN_EXCEL
  PRODUCT_SOIL_REPORT
  PRODUCT_CALC_REPORT
  PRODUCT_FAST_REPORT
}

enum EvidenceIntakeStatus {
  LANDED
  CLASSIFIED
  PROMOTING
  PROMOTED
  FAILED
  REJECTED
}

/// Universal intake record: one door for human-initiated evidence.
model EvidenceIntake {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @db.Uuid
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  intakeClass        EvidenceIntakeClass   @default(UNCLASSIFIED)
  status             EvidenceIntakeStatus  @default(LANDED)
  title              String
  originalFilename   String?
  sourceUrl          String?
  mediaType          String?
  byteSize           BigInt?
  contentSha256      String?               @db.Char(64)
  /// Relative path under intake root for landed files (market/soil/etc.).
  storageRelativePath String?
  inputArtifactId    String?               @db.Uuid
  productSubmissionId String?              @db.Uuid
  promoteResult      Json?
  errorCode          String?
  errorMessage       String?               @db.VarChar(2000)
  notes              String?
  correlationId      String
  idempotencyKey     String                @unique
  createdById        String                @db.Uuid
  createdBy          UserAccount           @relation("EvidenceIntakeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  classifiedAt       DateTime?
  promotedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([tenantId, intakeClass, createdAt])
  @@index([contentSha256])
  @@index([createdById])
  @@index([correlationId])
}

/// Gate 4R-A: materialized research topic (facet bundle over approved content).
model ResearchTopic {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Stable slug/hash of facet bundle (unique per tenant).
  topicKey      String
  title         String
  theme         KnowledgePackTheme
  /// FlahaSOIL | FlahaCALC | FlahaFAST | Markets | Unassigned
  productLane   String
  cropSlug      String               @default("")
  cropLabel     String               @default("")
  regionSlug    String               @default("")
  regionLabel   String               @default("")
  climateSlug   String               @default("")
  climateLabel  String               @default("")
  parameterKey  String               @default("")
  extractKind   String               @default("")
  entryCount    Int                  @default(0)
  lastIndexedAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  entries       ResearchTopicEntry[]

  @@unique([tenantId, topicKey])
  @@index([tenantId, theme, cropSlug, regionSlug])
  @@index([tenantId, productLane])
  @@index([tenantId, parameterKey])
  @@index([tenantId, extractKind])
}

model ResearchTopicEntry {
  id              String        @id @default(uuid()) @db.Uuid
  topicId         String        @db.Uuid
  topic           ResearchTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  packId          String        @db.Uuid
  packCode        String
  packTitle       String
  packVersion     Int           @default(1)
  itemId          String        @db.Uuid
  itemTitle       String
  extractKind     String
  snippet         String?       @db.VarChar(500)
  reviewState     KnowledgePackReviewState
  evidencePresent Boolean       @default(false)
  sourceUrl       String?
  createdAt       DateTime      @default(now())

  @@unique([topicId, itemId])
  @@index([packId])
  @@index([itemId])
}

/// Audit of research index rebuilds.
model ResearchIndexRebuild {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  actorUserId  String?     @db.Uuid
  actor        UserAccount? @relation("ResearchIndexRebuildActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  mode         String
  topicCount   Int         @default(0)
  entryCount   Int         @default(0)
  packCount    Int         @default(0)
  note         String?
  createdAt    DateTime    @default(now())

  @@index([tenantId, createdAt])
}

/// Gate 4B-A: which pack themes may feed a sister product (admin-governed).
/// Targets are FlahaCALC | FlahaFAST | FlahaSOIL (string, not freeform).
model ProductFeedPolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// FlahaCALC | FlahaFAST | FlahaSOIL
  targetProduct         String
  /// KnowledgePackTheme values allowed into handoff for this product.
  allowedThemes         String[] @default([])
  requireApprovedPacks  Boolean  @default(true)
  allowMarketContext    Boolean  @default(false)
  allowComparisonNotes  Boolean  @default(false)
  enabled               Boolean  @default(true)
  notes                 String?
  updatedById           String?  @db.Uuid
  updatedBy             UserAccount? @relation("ProductFeedPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tenantId, targetProduct])
  @@index([tenantId, enabled])
}

/// Gate 4I-B: audit + re-download of read-only product handoff envelopes.
model ProductHandoffExport {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exportedById     String   @db.Uuid
  exportedBy       UserAccount @relation("ProductHandoffExporter", fields: [exportedById], references: [id], onDelete: Restrict)
  /// Single primary target (never CALC+FAST merged).
  targetProduct    String
  envelopeVersion  String
  envelopeSha256   String   @db.Char(64)
  packCodes        String[] @default([])
  packIds          String[] @default([])
  /// Full envelope JSON for re-download and audit.
  envelope         Json
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, targetProduct, createdAt])
  @@index([exportedById])
}
