#
# Title: Small-host production env example (2 vCPU / 2 GB)
# Introduction:
# Template for /etc/flahaintel/production.env on a constrained full-stack droplet.
# Installer writes real secrets; never commit that file.
#
# Created by: Rafat Al Khashan
# Created date: 2026-08-19
# Last modified: 2026-08-20

NODE_ENV=production
AUTH_MODE=production

DATABASE_URL=postgresql://flaha_app:CHANGE_ME@127.0.0.1:5432/flaha_intel?schema=public
API_HOST=127.0.0.1
API_PORT=3003

# Public HTTPS origin. Must be https in production.
FLAHA_PUBLIC_HOST=intel.flaha.org
WEB_ORIGIN=https://intel.flaha.org
CORS_ORIGINS=https://intel.flaha.org
VITE_API_URL=

FLAHA_SESSION_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET_AT_LEAST_32_CHARS
SESSION_TTL_SECONDS=43200
SESSION_IDLE_SECONDS=7200
CSRF_COOKIE_NAME=flaha_csrf
CSRF_HEADER_NAME=x-flaha-csrf

ARTIFACT_STORE_ROOT=/var/lib/flahaintel/artifacts
FLAHA_ARTIFACT_ROOT=/var/lib/flahaintel/artifacts
FLAHA_STATE_DIR=/var/lib/flahaintel/state
FLAHA_INTAKE_ROOT=/var/lib/flahaintel/intakes
FLAHA_WEB_ROOT=/var/lib/flahaintel/web
FLAHA_BACKUP_ROOT=/var/lib/flahaintel/backups
FLAHA_WORKER_MODE=serial
FLAHA_BACKUP_RPO_HOURS=744
FLAHA_BACKUP_DEGRADED_HOURS=912
MAX_UPLOAD_BYTES=25000000
MAX_PREVIEW_BYTES=64000
QUARANTINE_RETENTION_DAYS=30
DISK_WARN_FREE_RATIO=0.10
DISK_BLOCK_FREE_RATIO=0.05

PYTHON_BIN=/opt/flahaintel/runtimes/scrapy/bin/python
SCRAPY_PYTHON=/opt/flahaintel/runtimes/scrapy/bin/python
SCRAPY_BIN=/opt/flahaintel/runtimes/scrapy/bin/scrapy
JAVA_BIN=/usr/bin/java
TIKA_JAR=/opt/flahaintel/runtimes/tika/tika-app-3.3.1.jar
TIKA_ALLOWLIST=/opt/flahaintel/current/benchmarks/ingestion/config/document-tika-parser-allowlist.xml
PLAYWRIGHT_CLI=/opt/flahaintel/runtimes/playwright/node_modules/.bin/playwright
PLAYWRIGHT_BROWSERS_PATH=/opt/flahaintel/runtimes/ms-playwright
WORKER_CONCURRENCY=1
WORKER_POLL_MS=3000
WORKER_IDLE_BACKOFF_MS=8000
# Persistent-loop cap. Serial oneshot overrides to 1 claim then advances this item's next stage.
WORKER_MAX_JOBS=100
WORKER_MAX_RUNTIME_MS=180000
WORKER_SHUTDOWN_MS=20000
# Provider defaults: DEFAULT_EXECUTION_LIMITS (60s wall / 15s startup). Override for Tika PDFs on this host.
EXTRACTION_WALL_TIMEOUT_MS=180000
EXTRACTION_STARTUP_TIMEOUT_MS=60000
FLAHA_DEFAULT_LANGUAGE_HINT=en
# API has NoNewPrivileges=true, so sudo systemctl cannot work. Touch this file; flahaintel-pipeline.path starts the oneshot.
FLAHA_PIPELINE_KICK_FILE=/var/lib/flahaintel/state/pipeline-kick
# Leftover; do not rely on it on this host:
# FLAHA_PIPELINE_KICK_CMD=sudo -n /usr/bin/systemctl start --no-block flahaintel-pipeline.service

LOG_LEVEL=info
HEALTH_TIMEOUT_MS=3000
CRAWL_POLICY_PATH=/etc/flahaintel/crawl-policy.json
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SUBMISSIONS_PER_USER_HOUR=20
RATE_LIMIT_SUBMISSIONS_PER_TENANT_HOUR=80
MAX_PAGE_SIZE=100

COLLECTION_INTERVAL_MINUTES=15
SCHEDULER_ENABLED=true
RSS_TIMEOUT_MS=15000
RSS_MAX_RESPONSE_BYTES=2000000
RSS_MAX_REDIRECTS=5
SHUTDOWN_TIMEOUT_MS=10000

FLAHA_BOOTSTRAP_TENANT_CODE=flaha-local
FLAHA_BOOTSTRAP_ADMIN_EMAIL=admin@flaha.local

NODE_OPTIONS=--max-old-space-size=384
