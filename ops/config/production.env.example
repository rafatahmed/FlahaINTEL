# FlahaINTEL Phase 3M production environment template
# Copy to a host-local path outside the repository. Never commit real secrets.

NODE_ENV=production
AUTH_MODE=production

# Core
DATABASE_URL=postgresql://flaha_app:CHANGE_ME@127.0.0.1:5432/flaha_intel?schema=public
API_HOST=127.0.0.1
API_PORT=3003
WEB_ORIGIN=https://intel.example.com
CORS_ORIGINS=https://intel.example.com
VITE_API_URL=https://intel.example.com

# Authentication (generate: openssl rand -base64 48)
FLAHA_SESSION_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET_AT_LEAST_32_CHARS
SESSION_TTL_SECONDS=43200
SESSION_IDLE_SECONDS=7200
CSRF_COOKIE_NAME=flaha_csrf
CSRF_HEADER_NAME=x-flaha-csrf

# Artifacts (canonical single root)
ARTIFACT_STORE_ROOT=/var/lib/flahaintel/artifacts
FLAHA_ARTIFACT_ROOT=/var/lib/flahaintel/artifacts
FLAHA_STATE_DIR=/var/lib/flahaintel/state
FLAHA_INTAKE_ROOT=/var/lib/flahaintel/intakes
MAX_UPLOAD_BYTES=25000000
MAX_PREVIEW_BYTES=64000
QUARANTINE_RETENTION_DAYS=30
DISK_WARN_FREE_RATIO=0.10
DISK_BLOCK_FREE_RATIO=0.05

# Workers / runtimes — paths written by ops/scripts/linux/provision-runtimes.sh
PYTHON_BIN=/opt/flahaintel/runtimes/scrapy/bin/python
SCRAPY_BIN=/opt/flahaintel/runtimes/scrapy/bin/scrapy
SCRAPY_PYTHON=/opt/flahaintel/runtimes/scrapy/bin/python
PLAYWRIGHT_CLI=/opt/flahaintel/runtimes/playwright/node_modules/.bin/playwright
PLAYWRIGHT_CHROMIUM_PATH=/opt/flahaintel/runtimes/ms-playwright/chromium-1228/chrome-linux/chrome
JAVA_BIN=/usr/bin/java
TIKA_JAR=/opt/flahaintel/runtimes/tika/tika-app-3.3.1.jar
TIKA_ALLOWLIST=/opt/flahaintel/current/benchmarks/ingestion/config/document-tika-parser-allowlist.xml

# Worker loop bounds
WORKER_CONCURRENCY=1
WORKER_POLL_MS=2000
WORKER_IDLE_BACKOFF_MS=5000
WORKER_MAX_JOBS=100
WORKER_SHUTDOWN_MS=30000
# Small host: kick serial pipeline on Submit (no 15-minute wait). Leave unset on laptop workers.
# FLAHA_PIPELINE_KICK_CMD=sudo -n /usr/bin/systemctl start --no-block flahaintel-pipeline.service

# Operations
LOG_LEVEL=info
HEALTH_TIMEOUT_MS=3000
CRAWL_POLICY_PATH=/etc/flahaintel/crawl-policy.json
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SUBMISSIONS_PER_USER_HOUR=30
RATE_LIMIT_SUBMISSIONS_PER_TENANT_HOUR=200
MAX_PAGE_SIZE=100

# RSS (existing)
COLLECTION_INTERVAL_MINUTES=15
SCHEDULER_ENABLED=true
RSS_TIMEOUT_MS=15000
RSS_MAX_RESPONSE_BYTES=2000000
RSS_MAX_REDIRECTS=5
SHUTDOWN_TIMEOUT_MS=10000
