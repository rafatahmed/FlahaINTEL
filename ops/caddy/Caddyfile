# FlahaINTEL Phase 3M Caddy reverse proxy
# TLS terminates here. API and static web remain on loopback only.

{
	admin off
	auto_https disable_redirects
}

{$FLAHA_PUBLIC_HOST:intel.example.com} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Request / upload size bound (Caddy request_body)
	request_body {
		max_size 26MB
	}

	handle /health {
		reverse_proxy 127.0.0.1:{$API_PORT:3003} {
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
	}

	handle /ready {
		reverse_proxy 127.0.0.1:{$API_PORT:3003} {
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{$API_PORT:3003} {
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
				read_timeout 120s
				write_timeout 120s
			}
			# WebSockets disabled by not enabling them
		}
	}

	handle {
		root * {$FLAHA_WEB_ROOT:/var/lib/flahaintel/web}
		try_files {path} /index.html
		file_server
	}

	log {
		output file {$FLAHA_ACCESS_LOG:/var/log/flahaintel/caddy-access.log}
		format json
	}
}
