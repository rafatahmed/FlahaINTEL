[Unit]
Description=FlahaINTEL API (loopback)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=flahaintel
Group=flahaintel
WorkingDirectory=/opt/flahaintel/current/apps/api
EnvironmentFile=/etc/flahaintel/production.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/flahaintel /var/log/flahaintel
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
