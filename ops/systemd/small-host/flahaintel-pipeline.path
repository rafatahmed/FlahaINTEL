#
# Title: Serial pipeline kick path (small host)
# Introduction: Starts the oneshot when the API touches a state file. Works with NoNewPrivileges (sudo cannot).
#
# Created by: Rafat Al Khashan
# Created date: 2026-08-21
# Last modified: 2026-08-21

[Unit]
Description=FlahaINTEL serial pipeline kick on state file
After=postgresql.service

[Path]
PathExists=/var/lib/flahaintel/state/pipeline-kick
PathChanged=/var/lib/flahaintel/state/pipeline-kick
PathModified=/var/lib/flahaintel/state/pipeline-kick
MakeDirectory=true
Unit=flahaintel-pipeline.service

[Install]
WantedBy=multi-user.target
