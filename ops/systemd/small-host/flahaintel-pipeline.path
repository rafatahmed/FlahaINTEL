#
# Title: Serial pipeline kick path (small host)
# Introduction: Starts the oneshot when the API writes the kick file. Works with NoNewPrivileges (sudo cannot).
#
# Created by: Rafat Al Khashan
# Created date: 2026-08-21
# Last modified: 2026-08-21
#
# Do not use PathExists: with a persistent file and Type=oneshot it retriggers
# until systemd TriggerLimit silences the unit — READY jobs then sit forever.

[Unit]
Description=FlahaINTEL serial pipeline kick on kick-file write
After=postgresql.service

[Path]
PathChanged=/var/lib/flahaintel/state/pipeline-kick
PathModified=/var/lib/flahaintel/state/pipeline-kick
MakeDirectory=true
TriggerLimitIntervalSec=30s
TriggerLimitBurst=8
Unit=flahaintel-pipeline.service

[Install]
WantedBy=multi-user.target
