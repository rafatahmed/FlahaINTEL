# Title: Market harvest oneshot (small host)
# Introduction: Daily MoCI/Amman/Mahaseel harvest; cadence still gates inside the CLI.
#
# Created by: Rafat Al Khashan
# Created date: 2026-08-19
# Last modified: 2026-08-19

[Unit]
Description=FlahaINTEL market harvest
After=network-online.target postgresql.service flahaintel-api.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=flahaintel
Group=flahaintel
WorkingDirectory=/opt/flahaintel/current
EnvironmentFile=/etc/flahaintel/production.env
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/opt/flahaintel/current/ops/scripts/linux/harvest-once.sh
Nice=5
MemoryMax=450M
MemoryHigh=380M
TimeoutStartSec=600
OOMPolicy=stop
