#
# Title: Serial pipeline timer (small host)
# Introduction: Wakes the oneshot pipeline every 15 minutes.
#
# Created by: Rafat Al Khashan
# Created date: 2026-08-19
# Last modified: 2026-08-19

[Unit]
Description=FlahaINTEL serial pipeline every 15 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=15min
AccuracySec=1min
Persistent=true
Unit=flahaintel-pipeline.service

[Install]
WantedBy=timers.target
