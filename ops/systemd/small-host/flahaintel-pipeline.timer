#
# Title: Serial pipeline timer (small host)
# Introduction: After boot only. Submit kicks the oneshot; not a 15-minute clock.
#
# Created by: Rafat Al Khashan
# Created date: 2026-08-19
# Last modified: 2026-08-21

[Unit]
Description=FlahaINTEL serial pipeline after boot (Submit kicks further runs)

[Timer]
OnBootSec=3min
Persistent=true
Unit=flahaintel-pipeline.service

[Install]
WantedBy=timers.target
