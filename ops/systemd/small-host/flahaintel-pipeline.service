# Title: FlahaINTEL serial pipeline oneshot (small host)
# Introduction: Runs acquisition → extract → normalize → advance → recovery one family at a time.
#
# Created by: Rafat Al Khashan
# Created date: 2026-08-19
# Last modified: 2026-08-19

[Unit]
Description=FlahaINTEL serial ingestion pipeline (one family at a time)
After=network.target postgresql.service flahaintel-api.service
Requires=postgresql.service

[Service]
Type=oneshot
User=flahaintel
Group=flahaintel
WorkingDirectory=/opt/flahaintel/current/apps/api
EnvironmentFile=/etc/flahaintel/production.env
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStart=/opt/flahaintel/current/ops/scripts/linux/serial-pipeline.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=700M
MemoryHigh=600M
TimeoutStartSec=900
OOMPolicy=stop
