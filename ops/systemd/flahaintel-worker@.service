[Unit]
Description=FlahaINTEL worker loop (%i)
After=network.target postgresql.service flahaintel-api.service
Requires=postgresql.service

[Service]
Type=simple
User=flahaintel
Group=flahaintel
WorkingDirectory=/opt/flahaintel/current/apps/api
EnvironmentFile=/etc/flahaintel/production.env
Environment=WORKER_ID=%i.%H
ExecStart=/usr/bin/node --import tsx src/production/workers/cli.ts %i
Restart=on-failure
RestartSec=10
StartLimitBurst=10
StartLimitIntervalSec=600
TimeoutStopSec=45
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/flahaintel /var/log/flahaintel /opt/flahaintel
MemoryMax=2G
RuntimeMaxSec=86400

[Install]
WantedBy=multi-user.target
