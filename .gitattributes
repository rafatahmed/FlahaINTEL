# ---------------------------------------------------------------------------
# Governed benchmark corpus: byte-stable UTF-8 LF for text fixtures
# ---------------------------------------------------------------------------
benchmarks/ingestion/corpus/**/*.csv text eol=lf
benchmarks/ingestion/corpus/**/*.json text eol=lf
benchmarks/ingestion/corpus/**/*.jsonl text eol=lf
benchmarks/ingestion/corpus/**/*.html text eol=lf
benchmarks/ingestion/corpus/**/*.md text eol=lf
benchmarks/ingestion/corpus/**/*.txt text eol=lf

# Governed non-UTF-8 and intentionally invalid HTML fixtures are binary.
benchmarks/ingestion/corpus/html/encoding-windows-1252.html binary
benchmarks/ingestion/corpus/html/encoding-iso-8859-1.html binary
benchmarks/ingestion/corpus/html/encoding-windows-1256.html binary
benchmarks/ingestion/corpus/html/encoding-iso-8859-6.html binary
benchmarks/ingestion/corpus/html/encoding-invalid-utf8.html binary

# Corpus binary documents stay binary regardless of path rules above.
benchmarks/ingestion/corpus/**/*.pdf binary
benchmarks/ingestion/corpus/**/*.docx binary
benchmarks/ingestion/corpus/**/*.pptx binary
benchmarks/ingestion/corpus/**/*.rtf binary

# Lockfiles and contract schemas: LF for reproducible CI diffs
package-lock.json text eol=lf
**/package-lock.json text eol=lf
packages/ingestion-contracts/**/*.json text eol=lf
)
